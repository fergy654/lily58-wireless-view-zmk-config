#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        thumb_shift: thumb_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_SHIFT";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
        };

        thumb_sym: thumb_sym {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_SYM";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        Gaming-Layer {
            bindings = <&to 3>;
            key-positions = <0 11>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   =   |
            // |  ESC  |  A  | S/GUI| D/CTL| F/ALT|  G   |                   |  H   | J/ALT | K/CTL | L/GUI|   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "`"  |  |  "\"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | SHIFT| GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | SYM   |
            //                     (thumb SHIFT: hold=Shift, tap=sticky-Shift)
            //                     (thumb SYM:   hold=Symbols layer, tap=sticky-Symbols layer)

            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1  &kp N2       &kp N3        &kp N4       &kp N5                                        &kp N6         &kp N7        &kp N8         &kp N9        &kp N0         &kp MINUS
&kp TAB     &kp Q   &kp W        &kp E         &kp R        &kp T                                         &kp Y          &kp U         &kp I          &kp O         &kp P          &kp EQUAL
&kp ESCAPE  &kp A   &hml LGUI S  &hml LCTRL D  &hml LALT F  &kp G                                         &kp H          &hmr RALT J   &hmr RCTRL K   &hmr RGUI L   &kp SEMICOLON  &kp SQT
&kp LSHFT   &kp Z   &kp X        &kp C         &kp V        &kp B      &kp GRAVE    &kp BACKSLASH         &kp N          &kp M         &kp COMMA      &kp DOT       &kp FSLH       &kp RIGHT_SHIFT
                            &thumb_shift LSHFT LSHFT  &kp LGUI     &kp SPACE  &mo 1        &mo 2         &kp BACKSPACE  &kp ENTER     &thumb_sym 4 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |       | ESC | HOME|  UP  | END  | PGUP |                   |      |   7   |   8   |   9  |   /   |       |
            // |       | SELA| LEFT| DOWN | RIGHT| PGDN |                   |   -  |   4   |   5   |   6  |   0   |       |
            // |       | UNDO| CUT | COPY | PASTE| REDO |        |  |       |      |   1   |   2   |   3  |   .   |       |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "NavNum";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans   &trans    &trans    &trans    &trans    &trans
&trans      &kp ESCAPE    &kp HOME      &kp UP        &kp END       &kp PAGE_UP                     &trans   &kp N7    &kp N8    &kp N9    &kp FSLH  &trans
&trans      &kp LC(A)     &kp LEFT      &kp DOWN      &kp RIGHT     &kp PAGE_DOWN                   &kp MINUS &kp N4    &kp N5    &kp N6    &kp N0    &trans
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Y)     &trans    &trans  &kp COMMA &kp N1    &kp N2    &kp N3    &kp DOT   &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans   &trans    &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                     &trans             &trans           &trans          &trans      &trans                &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_PREVIOUS  &kp K_NEXT  &kp K_MUTE            &kp K_PLAY_PAUSE
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &kp LEFT           &kp DOWN         &kp UP          &kp RIGHT   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans             &kp PAGE_DOWN    &kp PAGE_UP     &trans      &trans                &trans
                        &trans   &trans   &trans   &trans    &trans  &trans             &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming {
            display-name = "Gaming";
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                              &kp N6  &kp N7      &kp N8     &kp N9   &kp N0         &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E     &kp R     &kp T                               &kp Y   &kp U       &kp I      &kp O    &kp P          &kp EQUAL
&kp LEFT_SHIFT  &kp A   &kp S   &kp D     &kp F     &kp G                               &kp H   &kp J       &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT       &kp N   &kp M       &kp COMMA  &kp DOT  &kp FSLH       &kp ENTER
                                &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp BACKSPACE  &mo 2   &kp DELETE  &to 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |  ^  |  <  |  $   |  %   |      |                   |  @   |   &   |   *   |  '   |   `   |       |
            // |       |  {  |  (  |  )   |  }   |  =   |                   |  \   |   +   |   -   |  /   |   "   |       |
            // |       |  ~  |  [  |  ]   |  _   |  #   |        |  |       |  |   |   !   |   ;   |  :   |   ?   |       |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Symbols";
            bindings = <
&trans  &trans    &trans    &trans   &trans   &trans                    &trans    &trans    &trans   &trans   &trans    &trans
&trans  &kp CARET &kp LT    &kp DLLR &kp PRCNT &trans                   &kp AT    &kp AMPS  &kp KP_MULTIPLY &kp SQT &kp GRAVE &trans
&trans  &kp LBRC  &kp LPAR  &kp RPAR &kp RBRC  &kp EQUAL                &kp BSLH  &kp PLUS  &kp MINUS &kp FSLH &kp DQT  &trans
&trans  &kp TILDE &kp LBKT  &kp RBKT &kp UNDER &kp HASH   &trans &trans &kp PIPE  &kp EXCL  &kp SEMI &kp COLON &kp QMARK &trans
                            &trans   &trans    &trans    &trans  &trans &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
